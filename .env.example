# LLM provider (BYOK — your key stays in your environment, never sent to a
# Puxti server). Default is Anthropic; only ANTHROPIC_API_KEY is needed.
ANTHROPIC_API_KEY=sk-ant-...

# Any other provider: set these three instead (see README "LLM providers").
# LLM_PROVIDER=mistral        # openai | mistral | glm | deepseek | groq |
#                             # openrouter | gemini | bedrock | ollama | custom
# LLM_MODEL=mistral-large-latest
# LLM_API_KEY=...
# LLM_BASE_URL=               # optional — custom endpoints / Bedrock regions
# LLM_INPUT_COST_PER_MTOK=    # optional — enables --dry-run costs for
# LLM_OUTPUT_COST_PER_MTOK=   # models puxti doesn't know

# GitHub personal access token — needs repo scope (Contents + Pull requests write)
GITHUB_TOKEN=ghp_...

# dbt project
DBT_PROJECT_DIR=./dbt
DBT_PROFILES_DIR=~/.dbt

# Max parallel LLM calls during `puxti scan` (optional, default 4).
# Raise only if your Anthropic rate-limit tier allows it.
# LLM_CONCURRENCY=4

# Knowledge Graph storage. Unset = local SQLite file at ~/.puxti/graph.db.
# Set a Postgres DSN to use the Postgres backend instead (requires
# `pip install 'puxti[postgres]'`; the database must already exist).
# DATABASE_URL=postgresql://user:password@host:5432/puxti
