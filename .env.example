# Neo4j — matches docker-compose.yml defaults
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=puxti_dev

# Anthropic (BYOK — stays in your environment, never sent to a Puxti server)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub personal access token — needs repo scope (Contents + Pull requests write)
GITHUB_TOKEN=ghp_...

# dbt project
DBT_PROJECT_DIR=./dbt
DBT_PROFILES_DIR=~/.dbt
